type vendor_sprd_wcnd_socket, file_type;
type_transition vendor_sprd_connmgr socket_device:sock_file vendor_sprd_wcnd_socket "wcnd";
allow vendor_sprd_connmgr vendor_sprd_wcnd_socket:sock_file create_file_perms;
