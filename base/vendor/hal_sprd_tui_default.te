type vendor_hal_sprd_tui_default, domain;
type vendor_hal_sprd_tui_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_sprd_tui_default)
hal_server_domain(vendor_hal_sprd_tui_default, hal_sprd_tui)
binder_use(vendor_hal_sprd_tui_default)
hwbinder_use(vendor_hal_sprd_tui_default)
allow vendor_hal_sprd_tui_default tee_device:chr_file rw_file_perms;
