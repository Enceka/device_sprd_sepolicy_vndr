type vendor_hal_sprd_network_default, domain;
type vendor_hal_sprd_network_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_sprd_network_default)
hal_server_domain(vendor_hal_sprd_network_default, hal_sprd_network)
binder_use(vendor_hal_sprd_network_default)
hwbinder_use(vendor_hal_sprd_network_default)
# This local network-control HAL uses Binder, not Internet sockets.
get_prop(vendor_hal_sprd_network_default, vendor_sprd_radio_prop)
