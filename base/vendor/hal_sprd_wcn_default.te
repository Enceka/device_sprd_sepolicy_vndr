type vendor_hal_sprd_wcn_default, domain;
type vendor_hal_sprd_wcn_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_sprd_wcn_default)
hal_server_domain(vendor_hal_sprd_wcn_default, hal_sprd_wcn)
binder_use(vendor_hal_sprd_wcn_default)
hwbinder_use(vendor_hal_sprd_wcn_default)
allow vendor_hal_sprd_wcn_default vendor_sprd_wcnd_socket:sock_file write;
allow vendor_hal_sprd_wcn_default vendor_sprd_connmgr:unix_stream_socket connectto;
get_prop(vendor_hal_sprd_wcn_default, vendor_sprd_wcn_prop)
