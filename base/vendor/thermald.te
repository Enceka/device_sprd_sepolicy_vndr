type vendor_sprd_thermald, domain;
type vendor_sprd_thermald_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_sprd_thermald)
r_dir_file(vendor_sprd_thermald, sysfs_thermal)
allow vendor_sprd_thermald sysfs_thermal:file write;
