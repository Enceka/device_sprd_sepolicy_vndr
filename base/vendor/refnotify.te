type vendor_sprd_refnotify, domain;
type vendor_sprd_refnotify_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_sprd_refnotify)
allow vendor_sprd_refnotify self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow vendor_sprd_refnotify self:global_capability_class_set { setuid setgid };
allow vendor_sprd_refnotify vendor_sprd_spipe_device:chr_file rw_file_perms;
get_prop(vendor_sprd_refnotify, vendor_sprd_radio_prop)
r_dir_file(vendor_sprd_refnotify, sysfs_leds)
allow vendor_sprd_refnotify vendor_sprd_sysfs_dphy_ssc:file rw_file_perms;
allow vendor_sprd_refnotify rtc_device:chr_file rw_file_perms;
