get_prop(hal_power_default, vendor_sprd_power_prop)
r_dir_file(hal_power_default, vendor_sprd_sysfs_scene)
allow hal_power_default vendor_sprd_sysfs_scene:file write;
allow hal_power_default vendor_sprd_sysfs_cpuidle:dir search;
allow hal_power_default vendor_sprd_sysfs_cpuidle:file rw_file_perms;
allow hal_power_default proc_watermark_scale_factor:file rw_file_perms;
allow hal_power_default vendor_sprd_proc_walt:dir search;
allow hal_power_default vendor_sprd_proc_walt:file rw_file_perms;
allow hal_power_default cgroup:file rw_file_perms;
