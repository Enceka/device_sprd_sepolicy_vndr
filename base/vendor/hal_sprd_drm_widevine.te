type vendor_hal_sprd_drm_widevine, domain;
type vendor_hal_sprd_drm_widevine_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_sprd_drm_widevine)
hal_server_domain(vendor_hal_sprd_drm_widevine, hal_drm)
binder_use(vendor_hal_sprd_drm_widevine)
allow vendor_hal_sprd_drm_widevine tee_device:chr_file rw_file_perms;
allow vendor_hal_sprd_drm_widevine vendor_sprd_drm_data_file:dir create_dir_perms;
allow vendor_hal_sprd_drm_widevine vendor_sprd_drm_data_file:file create_file_perms;
allow vendor_hal_sprd_drm_widevine hal_codec2_server:fd use;
