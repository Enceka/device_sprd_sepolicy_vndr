# Stock HWC uses both vendor Binder and hardware Binder.
vndbinder_use(hal_graphics_composer_default)
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)
hal_client_domain(hal_graphics_composer_default, hal_sprd_enhance)
hal_client_domain(hal_graphics_composer_default, hal_power)
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
get_prop(hal_graphics_composer_default, vendor_sprd_graphics_prop)
