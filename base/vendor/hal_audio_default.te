hal_client_domain(hal_audio_default, hal_power)
set_prop(hal_audio_default, vendor_sprd_audio_prop)
get_prop(hal_audio_default, sprd_audio_debug_prop)

allow hal_audio_default vendor_sprd_modem_control:unix_stream_socket connectto;
allow hal_audio_default vendor_sprd_audio_dsp_log_device:chr_file rw_file_perms;
allow hal_audio_default mnt_vendor_file:dir search;
allow hal_audio_default vendor_sprd_audio_data_file:dir create_dir_perms;
allow hal_audio_default vendor_sprd_audio_data_file:file create_file_perms;
allow hal_audio_default vendor_sprd_audio_data_file:fifo_file create_file_perms;
allow hal_audio_default vendor_sprd_sysfs_headset:file r_file_perms;

# Keep the pipe ioctl whitelist separate from standard ALSA devices.
allow hal_audio_default vendor_sprd_audio_pipe_device:chr_file rw_file_perms;
# AUDIO_PIPE_BUFFERSIZE_SET, MAXRWSIZE_GET and POINT_ALLOC on /dev/apipe-pcm.
allowxperm hal_audio_default vendor_sprd_audio_pipe_device:chr_file ioctl {
    0x4102
    0x4105
    0x4108
};
