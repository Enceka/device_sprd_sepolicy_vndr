# Network access belongs to the companion gpsd daemon.
hal_client_domain(hal_gnss_default, hal_sprd_wcn)
allow hal_gnss_default vendor_sprd_wcn_device:chr_file rw_file_perms;
allow hal_gnss_default vendor_sprd_gnss_data_file:dir create_dir_perms;
allow hal_gnss_default vendor_sprd_gnss_data_file:file create_file_perms;
allow hal_gnss_default vendor_sprd_wcnd_socket:sock_file write;
allow hal_gnss_default vendor_sprd_connmgr:unix_stream_socket connectto;
get_prop(hal_gnss_default, vendor_sprd_wcn_prop)
