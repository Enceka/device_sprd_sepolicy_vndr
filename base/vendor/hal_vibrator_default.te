# The force-feedback HAL discovers sc27xx:vibrator through evdev names.
allow hal_vibrator_default input_device:dir r_dir_perms;
allow hal_vibrator_default input_device:chr_file rw_file_perms;
# EVIOCGNAME has a variable size; xperms use the command's low 16 bits.
allowxperm hal_vibrator_default input_device:chr_file ioctl {
    0x4506
    0x4580
    0x4581
};
