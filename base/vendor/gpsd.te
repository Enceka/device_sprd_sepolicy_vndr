type vendor_sprd_gpsd, domain;
type vendor_sprd_gpsd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_sprd_gpsd)
net_domain(vendor_sprd_gpsd)
allow vendor_sprd_gpsd vendor_sprd_wcn_device:chr_file rw_file_perms;
allow vendor_sprd_gpsd vendor_sprd_gnss_data_file:dir create_dir_perms;
allow vendor_sprd_gpsd vendor_sprd_gnss_data_file:file create_file_perms;
allow vendor_sprd_gpsd vendor_sprd_wcnd_socket:sock_file write;
allow vendor_sprd_gpsd vendor_sprd_connmgr:unix_stream_socket connectto;
