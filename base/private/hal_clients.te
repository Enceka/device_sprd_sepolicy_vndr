get_prop(radio, vendor_sprd_radio_prop)
get_prop(audioserver, vendor_sprd_audio_prop)
get_prop(cameraserver, vendor_sprd_camera_prop)
get_prop(surfaceflinger, vendor_sprd_graphics_prop)
