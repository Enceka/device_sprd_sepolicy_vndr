type vendor_sprd_engpc, domain;
type vendor_sprd_engpc_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_sprd_engpc)
allow vendor_sprd_engpc self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow vendor_sprd_engpc vendor_sprd_diag_device:chr_file rw_file_perms;
allow vendor_sprd_engpc vendor_sprd_audio_dsp_log_device:chr_file rw_file_perms;
get_prop(vendor_sprd_engpc, vendor_sprd_radio_prop)
get_prop(vendor_sprd_engpc, vendor_sprd_modem_prop)
allow vendor_sprd_engpc mnt_vendor_file:dir search;
allow vendor_sprd_engpc { proc_cmdline proc_bootconfig }:file r_file_perms;
allow vendor_sprd_engpc radio_device:chr_file rw_file_perms;
allow vendor_sprd_engpc serial_device:chr_file rw_file_perms;
allow vendor_sprd_engpc { vendor_sprd_modem_control vendor_sprd_refnotify }:unix_stream_socket connectto;
# Additional diagnostic permissions require captured AVCs in this domain.
